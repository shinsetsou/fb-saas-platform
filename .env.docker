# Default .env values for the Docker dev stack.
# Copy this to .env once (the entrypoint will not auto-generate one):
#   cp .env.docker .env
# The entrypoint will fill in APP_KEY on first boot if it's blank.

APP_NAME="fb-saas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database — MySQL on the docker "mysql" service.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fb_saas
DB_USERNAME=fb_saas
DB_PASSWORD=fb_saas
DB_ROOT_PASSWORD=root

# Sessions / cache / queue use the database by default. The mysql container
# is ready before the app container starts, so this is safe.
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe — leave blank in dev unless you want real API calls. The StripeUsageMeter
# is bound to a fake in the test environment, and the billing routes are
# behind auth, so the app boots fine without these.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_METERED=
STRIPE_METER_EVENT=ai_replies

# Facebook / Google — same: blank is fine for local dev. The Facebook/Google
# connect routes won't redirect anywhere useful without real client IDs.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/facebook/callback"
FACEBOOK_WEBHOOK_VERIFY_TOKEN=local-verify-token
FACEBOOK_GRAPH_VERSION=v25.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/google/callback"

# Anthropic — set ANTHROPIC_API_KEY to use the real Claude client. Without
# it, the bot engine will fail when called. The chat tester will still let
# you exercise the route.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
