{
    auto_https off
    admin off
    log {
        level INFO
    }
}

:8080 {
    root * /var/www/html/public

    encode zstd gzip

    # Serve static files directly from /public. Any request that does not
    # match a real file is forwarded to /index.php (the Laravel front
    # controller) via php_fastcgi.
    file_server

    @notStatic {
        not {
            file
        }
    }
    rewrite @notStatic /index.php

    php_fastcgi app:9000

    # Long-lived cache for hashed asset bundles, short cache for uploads.
    header /build/*   Cache-Control "public, max-age=31536000, immutable"
    header /assets/*  Cache-Control "public, max-age=31536000, immutable"
    header /storage/* Cache-Control "public, max-age=86400"
    header /*          Cache-Control "no-cache, no-store, must-revalidate"

    # Hide Caddy's own Server header (Laravel will set its own).
    header -Server
}
